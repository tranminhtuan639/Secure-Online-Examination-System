NODE_ENV=development
PORT=3000

# Ứng dụng dùng pooler (Supabase: Connection pooling). Local: Docker Compose.
DATABASE_URL=postgresql://exam:exam@localhost:5434/exam
# Migration dùng kết nối trực tiếp (Supabase: Direct connection). Local: giống DATABASE_URL.
DIRECT_URL=postgresql://exam:exam@localhost:5434/exam

# Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-change-me-change-me-change-me

# Danh sách origin được phép, cách nhau bằng dấu phẩy (web Vercel, web local, app Electron)
CORS_ORIGINS=http://localhost:5173

# Bật Swagger UI tại /docs và hợp đồng tại /openapi.json (true/false)
ENABLE_DOCS=true
