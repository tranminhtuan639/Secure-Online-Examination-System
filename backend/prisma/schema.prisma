// Mô hình dữ liệu theo SRS v1.0 mục 6 và các quyết định v1.1
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler, dùng khi chạy ứng dụng
  directUrl = env("DIRECT_URL") // kết nối trực tiếp, dùng cho migration
}

enum Role {
  STUDENT
  LECTURER
}

enum ExamStatus {
  ACTIVE
  CLOSED
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum ClientType {
  WEB
  DESKTOP
}

enum ExamEventType {
  ATTEMPT_STARTED
  ATTEMPT_SUBMITTED
  ATTEMPT_EXPIRED
  SECURE_MODE_ENTER
  FOCUS_LOST
  FOCUS_GAINED
  SECURE_MODE_EXIT
  WINDOW_CLOSE_REQUESTED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(STUDENT)
  displayName  String   @map("display_name")
  createdAt    DateTime @default(now()) @map("created_at")

  refreshTokens RefreshToken[]
  questions     Question[]
  exams         Exam[]
  attempts      Attempt[]
  usedRoleCodes RoleCode[]

  @@map("users")
}

// FR-07: refresh token đơn giản (7 ngày, lưu hash, đăng xuất thì thu hồi).
// Rotation và phát hiện dùng lại token cũ là P2 (FR-06), khi đó mới thêm family_id.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// FR-11..13, SEC-06: chỉ lưu hash, dùng một lần, có hạn. Mã chỉ nâng lên LECTURER nên không cần cột role.
model RoleCode {
  id        String    @id @default(uuid()) @db.Uuid
  codeHash  String    @unique @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedById  String?   @map("used_by") @db.Uuid
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  usedBy User? @relation(fields: [usedById], references: [id])

  @@map("role_codes")
}

model Question {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  content   String
  points    Float    @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  owner         User             @relation(fields: [ownerId], references: [id])
  options       QuestionOption[]
  examQuestions ExamQuestion[]
  answers       AttemptAnswer[]

  @@index([ownerId])
  @@map("questions")
}

model QuestionOption {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  content    String
  isCorrect  Boolean @default(false) @map("is_correct")
  position   Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_options")
}

model Exam {
  id              String     @id @default(uuid()) @db.Uuid
  ownerId         String     @map("owner_id") @db.Uuid
  title           String
  joinCode        String     @unique @map("join_code") // hiển thị lại cho giảng viên nên lưu dạng thường
  opensAt         DateTime   @map("opens_at")
  closesAt        DateTime   @map("closes_at")
  durationMinutes Int        @map("duration_minutes")
  status          ExamStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at")

  owner     User           @relation(fields: [ownerId], references: [id])
  questions ExamQuestion[]
  attempts  Attempt[]

  @@index([ownerId])
  @@map("exams")
}

model ExamQuestion {
  examId     String @map("exam_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  position   Int

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@id([examId, questionId])
  @@map("exam_questions")
}

model Attempt {
  id          String        @id @default(uuid()) @db.Uuid
  examId      String        @map("exam_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  startedAt   DateTime?     @map("started_at")
  deadline    DateTime?
  submittedAt DateTime?     @map("submitted_at")
  status      AttemptStatus @default(NOT_STARTED)
  score       Float?
  // Loại client của lần vào gần nhất (start hoặc tiếp tục). Chỉ là khai báo từ client, không phải bằng chứng.
  client      ClientType?

  exam    Exam            @relation(fields: [examId], references: [id])
  user    User            @relation(fields: [userId], references: [id])
  answers AttemptAnswer[]
  events  ExamEvent[]

  // Mỗi sinh viên chỉ có một lượt làm bài cho mỗi kỳ thi (FR-41, SEC-12)
  @@unique([examId, userId])
  // Truy vấn đóng các lượt quá hạn khi đọc (FR-46): status = IN_PROGRESS và deadline < now()
  @@index([status, deadline])
  @@map("attempts")
}

model AttemptAnswer {
  attemptId        String   @map("attempt_id") @db.Uuid
  questionId       String   @map("question_id") @db.Uuid
  selectedOptionId String?  @map("selected_option_id") @db.Uuid
  updatedAt        DateTime @updatedAt @map("updated_at")

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@id([attemptId, questionId])
  @@map("attempt_answers")
}

// FR-60..63. receivedAt do server đặt, clientOccurredAt chỉ để tham khảo vì client có thể bị sửa.
model ExamEvent {
  id               String        @id @default(uuid()) @db.Uuid
  attemptId        String        @map("attempt_id") @db.Uuid
  type             ExamEventType
  clientOccurredAt DateTime?     @map("client_occurred_at")
  receivedAt       DateTime      @default(now()) @map("received_at")
  metadata         Json?

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, receivedAt])
  @@map("exam_events")
}
